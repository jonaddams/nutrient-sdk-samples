# Copy this file to .env.local and fill in the values you need.
#   cp env.sample .env.local
# Only the license key is required to run the Web SDK samples; the rest are
# only needed for the sample groups that call a backend (see README → Backends).

# --- Required: Nutrient license key (client-side) ---
NEXT_PUBLIC_NUTRIENT_LICENSE_KEY=

# --- SDK versions (client-side) ---
NEXT_PUBLIC_WEB_SDK_VERSION=1.16.1
NEXT_PUBLIC_DOCUMENT_AUTHORING_SDK_VERSION=1.16.0

# --- AI Document Processing (XtractFlow) ---
NEXT_PUBLIC_NUTRIENT_API_URL=https://api.xtractflow.com
NUTRIENT_AUTH_TOKEN=

# --- Nutrient DWS API ---
NUTRIENT_API_BASE_URL=https://api.nutrient.io/
NUTRIENT_API_KEY=

# --- Python SDK backend (defaults to http://localhost:8080) ---
# Source: https://github.com/jonaddams/python-fast-api
NEXT_PUBLIC_PYTHON_SDK_API_URL=http://localhost:8080

# --- Java SDK backend (defaults to http://localhost:8080) ---
NEXT_PUBLIC_JAVA_SDK_API_URL=http://localhost:8080

# --- .NET SDK backend ---
NEXT_PUBLIC_DOTNET_SDK_API_URL=https://nutrient-dotnet-api-production.up.railway.app
# Server-side only. Read by app/api/dotnet-sdk/* route handlers and forwarded to the .NET API.
DOTNET_SDK_API_KEY=replace-me

# --- Indexed search demo (Postgres) ---
# Used by lib/db.ts and the `pnpm index` / `pnpm seed-search` scripts.
DATABASE_URL=
# Direct (non-pooled) connection for seeding; falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# --- Email extraction pipeline (app/python-sdk/email-extraction-pipeline) ---
# Its OWN Neon database. NOT DATABASE_URL, which is the indexed-search demo above:
# both are valid Postgres connections, so mixing them up fails late as a missing
# table rather than at connect time.
EXTRACTIONS_DATABASE_URL=
EXTRACTIONS_DATABASE_URL_UNPOOLED=

# Resend webhook signing secret (whsec_...). The inbound route returns 500 without
# it rather than accepting unverified posts. Any whsec_-prefixed base64 value works
# locally, as long as the server and scripts/email-extraction-pipeline agree.
RESEND_WEBHOOK_SECRET=

# Resend API key, for fetching the body and attachments of a received email.
RESEND_API_KEY=

# The inbound address THIS sample owns. A Resend managed subdomain receives mail for
# EVERY username at it, and Resend fans each message out to every webhook subscribed
# to email.received — so without this, a second sample receiving email would ingest
# this one's mail and vice versa. Mail addressed elsewhere is acknowledged and not
# recorded.
INBOUND_RECIPIENT=invoices@your-subdomain.resend.app

# Who may trigger model and SDK spend. Empty means open, which is wrong for a
# deployment: the dashboard shows every extraction, so an open inbox lets one
# visitor read another's invoice. Keep this restricted and let everyone else drive
# the pipeline from the Replay buttons.
INBOUND_SENDER_ALLOWLIST=

# Optional. Who replayed fixtures appear to come from. Defaults to the first
# allowlist entry (so `@nutrient.io` yields `replay@nutrient.io`), which keeps the
# Replay buttons working whatever the allowlist is set to.
REPLAY_FROM=

# Ceiling on extractions per rolling hour. Bounds the damage if a sender is spoofed
# or a mailing list is pointed at the address. Over the cap a row is still written
# (`hourly_cap_reached`) but no workflow starts, and Resend retains the mail.
MAX_EXTRACTIONS_PER_HOUR=50

# The FastAPI extraction service (python-fast-api). `make dev` serves :8080.
EXTRACTION_SERVICE_URL=http://localhost:8080
EXTRACTION_SERVICE_TOKEN=

# Bearer token for the dashboard read API. Unset leaves it open — fine locally,
# wrong deployed.
DASHBOARD_TOKEN=
